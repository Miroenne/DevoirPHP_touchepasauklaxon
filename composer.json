{
  "name": "miroenne/touchepasauklaxon",
  "description": "Devoir de formation sur le langage PHP",
  "license": "MIT",
  "config": {
    "process-timeout": 0
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "authors": [
    {
      "name": "Miroenne"
    }
  ],
  "minimum-stability": "stable",
  "require": {
    "twbs/bootstrap": "^5.3"
  },
  "scripts": {
    "dev-serv": [
      "Composer\\Config::disableProcessTimeout",
      "php -S localhost:8080 -t public public/index.php"
    ],
    "css": "sass scss/custom.scss public/css/app.css --style=compressed --quiet-deps",
    "css:watch": "sass --watch scss/custom.scss public/css/app.css --quiet-deps"
  },
  "scripts-descriptions": {
    "dev-serv": "start development server on port 8080"
  }
}
